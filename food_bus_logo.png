\"key\":\"travel_feed_sparse_metadata\",\"label\":\"Travel Feed: Sparse metadata\"},{\"key\":\"pending_image_card_v2_single\",\"label\":\"Pending: Image Card V2 — Single\"},{\"key\":\"pending_image_card_v2_single_collapse_on_image_completion\",\"label\":\"Pending: Image Card V2 — Single (collapse after image generation, iOS)\"},{\"label\":\"Pending: Product Card V2 — Single\",\"key\":\"pending_product_card_v2_single\"},{\"key\":\"pending_product_carousel\",\"label\":\"Pending: Compact Product Carousel — No price\"},{\"label\":\"Pending: Slideshow 16:9 — 4 images (Auto-scroll)\",\"key\":\"pending_slideshow_landscape_auto_scroll\"},{\"key\":\"conversation_bottom_slideshow_square_single\",\"label\":\"Conversation Bottom: Slideshow 1:1 — 1 image\"},{\"key\":\"previous_ad_native_image_preamble\",\"label\":\"ImageCardV2: Native — Preamble\"},{\"key\":\"previous_ad_native_image_keep_visible\",\"label\":\"ImageCardV2: Native — Keep visible on next send\"},{\"key\":\"geico_test_agent\",\"label\":\"GEICO Test Agent\"},{\"label\":\"ImageCardV2: Single — One-line subtitle\",\"key\":\"image_card_v2_single_one_line\"}]},\"is_device_based\":false,\"passed\":false},\"1122994996\":{\"name\":\"1122994996\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"templates\":[{\"revision\":\"c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721\",\"id\":\"product-strategy\",\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/product-strategy/c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721/cover.png\",\"title\":\"Product Strategy\",\"publisher\":\"openai\",\"source\":{\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/product-strategy/c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721/presentation.pb\",\"format\":\"presentation-protobuf\",\"sha256\":\"752ddf9ebb318c4a11e37373dbf053e6450336b9ed45a62eacf4d042f51c6eae\",\"byteLength\":410320}},{\"id\":\"